# Copy this file to `.env` (kept out of git) and fill in real values.

# Only required for AI-found sources (the "Find more sources" button on an
# incident's detail panel). Semantic search does NOT need this -- it runs
# entirely in-process (BM25 + a local cross-encoder reranker), no database or
# API key. Get a free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# JSON array of allowed frontend origins for CORS. Must include your deployed
# frontend URL in production.
CABLEINCIDENTS_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Gemini model used to answer "find more sources" requests.
CABLEINCIDENTS_GOOGLE_MODEL_NAME=gemini-3.6-flash

# Local fastembed (ONNX Runtime) cross-encoder used to rerank semantic search
# candidates -- no API key, no PyTorch, low memory. Downloaded once on first use.
CABLEINCIDENTS_RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
