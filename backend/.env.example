# Copy this file to `.env` (kept out of git) and fill in real values.

# Only required for AI-found sources (the "Find more sources" button on an
# incident's detail panel). Semantic search does NOT need this -- it computes
# embeddings locally. Get a free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Required only for semantic search. Points at a Postgres instance with the
# pgvector extension enabled (see backend/db/schema.sql). Local Docker default
# shown below; for production use your managed Postgres connection string
# (e.g. from Supabase or Neon).
CABLEINCIDENTS_DATABASE_URL=postgresql://cableincidents:cableincidents@localhost:5432/cableincidents

# JSON array of allowed frontend origins for CORS. Must include your deployed
# frontend URL in production.
CABLEINCIDENTS_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Gemini model used to answer "find more sources" requests.
CABLEINCIDENTS_GOOGLE_MODEL_NAME=gemini-3.6-flash

# Local fastembed (ONNX Runtime) model used to compute embeddings for semantic
# search -- no API key, no PyTorch, low memory. Downloaded once on first use.
CABLEINCIDENTS_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
